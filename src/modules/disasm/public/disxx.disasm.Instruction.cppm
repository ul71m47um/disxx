auto std::formatter<disxx::disasm::Instruction>::format(const disxx::disasm::Instruction &insn, std::format_context &ctx) const
{
	using namespace disxx::disasm;

	const auto &id{insn.GetInstructionIdentifier()};
	const auto &oprs{insn.GetOperands()};

	std::stringstream str;
	str << s_MnemonicTable.at(id).data();
	
	switch (id)
	{
	  case InstructionIdentifier::ID_TBL: [[fallthrough]];
	  case InstructionIdentifier::ID_TBLX: [[fallthrough]];
	  case InstructionIdentifier::ID_LUTI2: [[fallthrough]];
	  case InstructionIdentifier::ID_LUTI4:
	  {
		for (auto i{0UL}; const auto &ptr : oprs)
		{
			if (i == 1)
				str << " {";
			else if (i == oprs.size() - 1)
				str << " }";
			str
				<< (i == 0 ? " " : ", ")
				<< ptr->GetMnemonic();
			i++;
		}

		return std::format_to
		(
			ctx.out(),
			"{}",
			str.str()
		);
	  }

	  case InstructionIdentifier::ID_ST1: [[fallthrough]];
	  case InstructionIdentifier::ID_ST2: [[fallthrough]];
	  case InstructionIdentifier::ID_ST3: [[fallthrough]];
	  case InstructionIdentifier::ID_ST4: [[fallthrough]];
	  case InstructionIdentifier::ID_LD1: [[fallthrough]];
	  case InstructionIdentifier::ID_LD2: [[fallthrough]];
	  case InstructionIdentifier::ID_LD3: [[fallthrough]];
	  case InstructionIdentifier::ID_LD4: [[fallthrough]];
	  case InstructionIdentifier::ID_STL1: [[fallthrough]];
	  case InstructionIdentifier::ID_LD1R: [[fallthrough]];
	  case InstructionIdentifier::ID_LD2R: [[fallthrough]];
	  case InstructionIdentifier::ID_LD3R: [[fallthrough]];
	  case InstructionIdentifier::ID_LD4R: [[fallthrough]];
	  case InstructionIdentifier::ID_LDAP1:
	  {
		// FIXME: Should be able to handle all kinds of these instructions
		str << " {";
	  	for (auto i{0UL}; const auto &ptr : oprs)
		{
			if (i == oprs.size() - 2)
				str << " }";
			str
				<< (i == 0 ? " " : ", ")
				<< ptr->GetMnemonic();
			i++;
		}

		return std::format_to
		(
			ctx.out(),
			"{}",
			str.str()
		);
	  }

	  case InstructionIdentifier::ID_SYSL:
	  {
		if (oprs.size() != 5) [[unlikely]]
			throw std::logic_error{"OperandsCountError"};

		if ((*oprs.begin())->GetType() == operand::AbstractOperand::Type::TYPE_REGISTER)
		{
			for (auto i{0UL}; const auto &ptr : oprs)
			{
				if (i == 1 || i == oprs.size() - 1)
					str
						<< ", "
						<< std::regex_replace
						(
							ptr->GetMnemonic(),
							std::regex{R"(#0x)"},
							"c"
						);
				else
					str
						<< (i == 0 ? " " : ", ")
						<< ptr->GetMnemonic();
				i++;
			}
		
			return std::format_to
			(
				ctx.out(),
				"{}",
				str.str()
			);
		}

		for (auto i{0UL}; const auto &ptr : oprs)
		{
			if (i == 0 || i == 3)
				str
					<< ", "
					<< std::regex_replace
					(
						ptr->GetMnemonic(),
						std::regex{R"(#0x)"},
						"c"
					);
			else
				str
					<< (i == 0 ? " " : ", ")
					<< ptr->GetMnemonic();
			i++;
		}

		return std::format_to
		(
			ctx.out(),
			"{}",
			str.str()
		);
	  }

	  default:
	  {
		for (auto i{0UL}; const auto &ptr : oprs)
		{
	  		str
				<< (
					i == 0 && ptr->GetType() == operand::AbstractOperand::Type::TYPE_CONDITION
						? "."
						: (
							i == 0 || (i == 1 && oprs.at(0)->GetType() == operand::AbstractOperand::Type::TYPE_CONDITION)
								? " "
								: ", "
						)
				)
				<< ptr->GetMnemonic();
			i++;
		}

		return std::format_to
		(
			ctx.out(),
			"{}",
			str.str()
		);
	  }
	}
}
*/
