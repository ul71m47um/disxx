        {operand::Register::Identifier::ID_PMEVTYPER24_EL0, "pmevtyper24_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER25_EL0, "pmevtyper25_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER26_EL0, "pmevtyper26_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER27_EL0, "pmevtyper27_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER28_EL0, "pmevtyper28_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER29_EL0, "pmevtyper29_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER30_EL0, "pmevtyper30_el0"},
        {operand::Register::Identifier::ID_PMEVTYPER31_EL0, "pmevtyper31_el0"}
	};

	template <std::output_iterator<char> T>
